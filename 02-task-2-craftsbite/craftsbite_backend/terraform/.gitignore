# Craftsbite Terraform .gitignore

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# such as discord_bot_token, discord_public_key, etc.
*.tfvars
*.tfvars.json

# But keep example .tfvars files
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (check this in after initial terraform init)
# .terraform.lock.hcl