# Discords secrets are now fetched from AWS SSM Parameter Store:
#   /craftsbite/DISCORD_BOT_TOKEN
#   /craftsbite/DISCORD_PUBLIC_KEY
#   /craftsbite/gchat_service_account_json
# Set them via Terraform or AWS CLI. Do NOT set them as env vars.

DISCORD_APPLICATION_ID=

DYNAMODB_ENDPOINT=
DYNAMODB_TABLE=craftsbite
CUTOFF_TIME=21:00
TIMEZONE=Asia/Dhaka

AWS_REGION=ap-southeast-1

LAMBDA_SELF_FUNCTION_NAME=
LAMBDA_MANAGEMENT_FUNCTION_NAME=
LAMBDA_OPS_FUNCTION_NAME=

# Google Chat audience URL (API Gateway invoke URL)
# Set this after deploying API Gateway, or leave empty for Discord-only usage
GCHAT_AUDIENCE=